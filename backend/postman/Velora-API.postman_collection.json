      "name": "2 - Products CRUD",
      "item": [
        {
          "name": "2.1 Get all products (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('catalogue present', () => pm.expect(b.total).to.be.above(0));",
                  "pm.collectionVariables.set('existingSlug', b.data[0].slug);",
                  "pm.collectionVariables.set('existingId', b.data[0]._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Filter + search products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?gender=Him&family=Woody&sort=price-asc",
