  "item": [
    {
      "name": "1 - Authentication",
      "item": [
        {
          "name": "1.1 Login as ADMIN (saves adminToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Set adminEmail and adminPassword in the collection Variables tab first (the account you made with `npm run create-admin`)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('role is admin', () => pm.expect(d.user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('adminToken', d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Who am I? (admin token required)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('user returned', () => pm.expect(pm.response.json().data.user.email).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Login with WRONG password (401)",
