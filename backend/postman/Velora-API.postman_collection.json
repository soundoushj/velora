              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json().data;",
                  "pm.test('has _id and slug', () => pm.expect(p._id && p.slug).to.be.ok);",
                  "pm.collectionVariables.set('productId', p._id);"
                ]
              }
            }
