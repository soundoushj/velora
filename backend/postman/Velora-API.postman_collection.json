            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Midnight Oud {{$timestamp}}\",\n  \"brand\": \"Velora\",\n  \"description\": \"A smoky oud with saffron and amber, created from Postman.\",\n  \"price\": 25000,\n  \"category\": \"Eau de parfum\",\n  \"stock\": 12,\n  \"gender\": \"Unisex\",\n  \"family\": \"Oriental\",\n  \"familyLabel\": \"Amber Woody\",\n  \"size\": \"100 ml\",\n  \"notes\": {\n    \"top\": [\n      \"Saffron\"\n    ],\n    \"heart\": [\n      \"Rose\"\n    ],\n    \"base\": [\n      \"Oud\",\n      \"Amber\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('stamp', Date.now());"
