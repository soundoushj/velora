{
  "name": "velora-backend",
  "version": "1.0.0",
  "description": "REST API for the Velora perfume store (WAMD university project)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed-products.js",
    "seed:reset": "node scripts/seed-products.js --reset",
    "create-admin": "node scripts/create-admin.js",
    "generate-secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\"",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.8"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
